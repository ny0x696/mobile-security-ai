{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized Scope",
  "type": "object",
  "required": ["id", "targets", "allowed_methods", "prohibited_methods"],
  "properties": {
    "id": {"type": "string", "pattern": "^SCP-[0-9A-Za-z._-]+$"},
    "program": {"type": "string"},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "excluded_targets": {"type": "array", "items": {"type": "string"}},
    "allowed_methods": {"type": "array", "items": {"type": "string"}},
    "prohibited_methods": {"type": "array", "items": {"type": "string"}},
    "rate_limit": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
